<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#A52A2A"
        android:gravity="center_vertical"
        android:text="Gra w kości. Autor: 0000000000000"
        android:textAlignment="viewStart"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/rollTheDiceButton"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D2691E"
        android:gravity="center"
        android:text="RZUĆ KOŚĆMI"
        app:cornerRadius="12dip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4EFEF"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dice1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/questionmark" />

        <ImageView
            android:id="@+id/dice2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/questionmark" />

        <ImageView
            android:id="@+id/dice3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/questionmark" />

        <ImageView
            android:id="@+id/dice4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/questionmark" />

        <ImageView
            android:id="@+id/dice5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/questionmark" />

    </LinearLayout>

    <TextView
        android:id="@+id/latestScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wynik tego losowania:"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wynik gry:"
        android:textAlignment="center" />

    <Button
        android:id="@+id/resetButton"
        android:layout_width="191dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D2691E"
        android:text="RESETUJ WYNIK"
        app:cornerRadius="12dip" />

</LinearLayout>